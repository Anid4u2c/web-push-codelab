{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "app/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/push/config",
        "function": {
          "functionId": "pushConfig",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/push/test",
        "function": {
          "functionId": "testPush",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/push/receipt",
        "function": {
          "functionId": "pushReceipt",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "push",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.log",
        ".secret.local",
        ".runtimeconfig.json"
      ]
    }
  ]
}
